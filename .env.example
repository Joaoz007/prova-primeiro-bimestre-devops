# ============================================================
# API de Reservas TechNova — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env.
# ============================================================

# Porta HTTP da API (opcional; padrão: 3000)
PORT=3000

# Conexão da API com o banco de dados PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=technova
DB_USER=technova_user
DB_PASS=
DB_SSL=false

# Variáveis do serviço PostgreSQL no Docker Compose
# Devem ter os mesmos valores de DB_NAME, DB_USER e DB_PASS acima
POSTGRES_DB=technova
POSTGRES_USER=technova_user
POSTGRES_PASSWORD=